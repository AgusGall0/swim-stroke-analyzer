# --- Entornos virtuales ---
.venv/
venv/
env/
.env

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# --- Video (de terceros o de nadadores: no se versiona) ---
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.m4v

# --- Fotogramas extraídos ---
# Se ignoran todas las imágenes para no versionar fotogramas por accidente.
# Si la documentación necesita una imagen propia, agregar una excepción
# explícita, como la de docs/ acá abajo.
fotogramas/
*.png
*.jpg
*.jpeg
*.bmp
*.tif
*.tiff

# Excepción: las figuras que son el entregable del proyecto viven en docs/ y sí
# se versionan. El motivo está en CLAUDE.md, en "Qué se versiona aunque sea
# derivado". No es una puerta para volcar acá cualquier figura de corrida: las
# figuras de los informes siguen viviendo en salidas/, que está ignorada.
!docs/*.png

# --- Modelo de MediaPipe (se descarga con scripts/descargar_modelo.py) ---
modelos/
*.task

# --- Datos generados (landmarks, métricas, figuras, metadata de corridas) ---
*.parquet
salidas/
resultados/

# --- Binarios ---
*.exe
*.o
*.so
*.dll
